# ReconLogic — Real service integrations (fill with your own keys)
# Database (PostgreSQL — NUMERIC(18,4) for all money; Decimal for Python math)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/reconlogic

# Auth (Supabase JWT validated via JWKS)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>
SUPABASE_JWKS_URL=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json

# AI / OCR (AWS Textract + OpenAI Structured Outputs)
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_REGION=us-east-1
S3_BUCKET_NAME=<your-s3-or-r2-bucket>
S3_ENDPOINT_URL=<leave-blank-for-aws-or-set-for-r2>
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini

# Queue (Redis / Upstash)
REDIS_URL=redis://localhost:6379/0

# App / Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
